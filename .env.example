# ============================================================================
# CHEATCODEZ API CONFIGURATION
# ============================================================================
# CheatCodez works with ANY OpenAI-compatible API
# You only need ONE of these configurations

# ----------------------------------------------------------------------------
# OPTION 1A: OpenAI with Projects (RECOMMENDED - System prompts in OpenAI)
# ----------------------------------------------------------------------------
# Get API key: https://platform.openai.com/api-keys
# Get Project ID: https://platform.openai.com/projects
# Cost: ~$0.01 per 100 cheat codes
#
# SETUP:
# 1. Create a project at https://platform.openai.com/projects
# 2. Upload your GOD_PROMPT as a system.md file in the project
# 3. Copy the Project ID (starts with proj_...)
# 4. Paste it below
# 5. Your frontend should call /api/generate (not /api/optimize)
#
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_PROJECT_ID=proj_your-project-id-here
# OPENAI_MODEL=gpt-4o-mini  # Default model (optional)

# ----------------------------------------------------------------------------
# OPTION 1B: OpenAI without Projects (Legacy - System prompt in code)
# ----------------------------------------------------------------------------
# If you don't want to use Projects, just set OPENAI_API_KEY above
# and leave OPENAI_PROJECT_ID blank. Uses /api/optimize endpoint.
# System prompt lives in server.js (GOD_PROMPT constant)

# ----------------------------------------------------------------------------
# OPTION 2: Anthropic Claude
# ----------------------------------------------------------------------------
# Get API key: https://console.anthropic.com/
# Cost: ~$0.02 per 100 cheat codes
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Default model (optional)

# ----------------------------------------------------------------------------
# OPTION 3: Perplexity (Good for research-heavy prompts)
# ----------------------------------------------------------------------------
# Get API key: https://www.perplexity.ai/settings/api
# Uses OpenAI-compatible API format
# PERPLEXITY_API_KEY=pplx-your-key-here
# API_URL=https://api.perplexity.ai/chat/completions
# MODEL_NAME=llama-3.1-sonar-large-128k-online

# ----------------------------------------------------------------------------
# OPTION 4: Together AI (Cheap, fast)
# ----------------------------------------------------------------------------
# Get API key: https://api.together.xyz/settings/api-keys
# API_KEY=your-together-key-here
# API_URL=https://api.together.xyz/v1/chat/completions
# MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# ----------------------------------------------------------------------------
# OPTION 5: OpenRouter (Access to multiple models)
# ----------------------------------------------------------------------------
# Get API key: https://openrouter.ai/keys
# API_KEY=sk-or-your-key-here
# API_URL=https://openrouter.ai/api/v1/chat/completions
# MODEL_NAME=anthropic/claude-3.5-sonnet

# ----------------------------------------------------------------------------
# OPTION 6: Custom OpenAI-compatible API
# ----------------------------------------------------------------------------
# Use this for any OpenAI-compatible endpoint (LM Studio, LocalAI, etc.)
# API_KEY=your-api-key
# API_URL=https://your-api-url.com/v1/chat/completions
# MODEL_NAME=your-model-name

# ----------------------------------------------------------------------------
# NO API KEY? No problem!
# ----------------------------------------------------------------------------
# If you don't set any API key, CheatCodez uses a rule-based fallback
# It's not as smart, but it works for testing

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=development  # Set to 'production' in production

# CORS - Allowed origins in production (comma-separated)
# Example: ALLOWED_ORIGINS=https://cheatcodez.com,https://www.cheatcodez.com
# Leave empty in development for open CORS
ALLOWED_ORIGINS=

# ============================================================================
# PAYMENT SYSTEM
# ============================================================================
# Valid verification codes for upgrades (comma-separated)
# Generate unique codes for each paying customer
VALID_CODES=UNLOCK2024,CHEAT9999,PREMIUM123,GODMODE777

# How to use:
# 1. User pays via Ko-fi/PayPal
# 2. You send them a code from this list
# 3. They enter it on the site
# 4. Unlimited access unlocked

# Pro tip: Make codes memorable and unique per customer
# Examples: ULTRA2024, FASTPASS, INFINITE, WINNER99
